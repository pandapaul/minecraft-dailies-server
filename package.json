{
  "name": "minecraft-dailies-server",
  "version": "1.0.4",
  "description": "Serves up fresh Minecraft quests daily.",
  "main": "server.js",
  "scripts": {
    "lint": "standard",
    "debug": "node debug server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "document": "apidoc -i ./routes -o ./static/docs",
    "dynamo:start": "docker rm -f dynamodb-local >/dev/null 2>&1 || true && docker run -d --name dynamodb-local -p 8888:8000 amazon/dynamodb-local",
    "dynamo:stop": "docker rm -f dynamodb-local || true",
    "dev": "AWS_REGION=us-east-1 DYNAMO_ENDPOINT=http://localhost:8888 DYNAMO_TABLE_PREFIX=dev_ AWS_ACCESS_KEY_ID=dummy AWS_SECRET_ACCESS_KEY=dummy node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandapaul/minecraft-dailies-server.git"
  },
  "author": "Paul Anderson",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/pandapaul/minecraft-dailies-server/issues"
  },
  "homepage": "https://github.com/pandapaul/minecraft-dailies-server#readme",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.637.0",
    "@aws-sdk/lib-dynamodb": "^3.637.0",
    "body-parser": "^1.15.0",
    "chance": "^1.0.1",
    "dotenv": "^16.4.5",
    "escape-string-regexp": "^1.0.5",
    "express": "^4.13.4",
    "minecraft-dailies-ui": "./static",
    "socket.io": "^1.4.8",
    "yggdrasil": "^0.1.0"
  },
  "devDependencies": {
    "apidoc": "^0.16.1",
    "standard": "^10.0.2"
  },
  "standard": {
    "ignore": [
      "/static/docs"
    ]
  }
}
